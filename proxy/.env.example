# Every value is optional; unset values fall back to the literals in src/config.js.

# The site the wrapper forwards to (scheme + host, no trailing slash needed)
TARGET_ORIGIN=https://annas-archive.gl

# The required 14-character ordered sequence
ACCESS_SEQUENCE=annas-arichive

# Maximum first-character-to-last-character span, spacers included
MAX_SEQUENCE_SPAN=17

# true = case-sensitive matching, false = case-insensitive
CASE_SENSITIVE=true

# Target lock: the wrapper only proxies hosts containing this marker
ENFORCE_TARGET_ALLOWLIST=true
ALLOWED_TARGET_HOST_MARKERS=annas-archive

# Query parameter used to carry the sequence across links/redirects/forms
TOKEN_QUERY_PARAM=gateway

# Remove the token parameter before the request reaches the target site
STRIP_TOKEN_BEFORE_FORWARDING=true

# Rewrite links/forms/redirects so browsing keeps working (false = byte-exact passthrough)
REWRITE_LINKS=true

# Minimal audit logging: timestamps, method, URL length, truncated URL hash
AUDIT_LOG=true

PORT=8080
HOST=0.0.0.0
